# syntax=docker/dockerfile:1
# Build stage — context must be the repo root
FROM golang:1.26-alpine AS builder

RUN apk add --no-cache ca-certificates tzdata

# Place the shared local module where the replace directive points
COPY leanschool-model/ /leanschool-model/

WORKDIR /app

COPY leanschool/ .

RUN go mod download && \
    CGO_ENABLED=0 GOOS=linux go build -o /leanschool ./cmd/...

# Runtime stage
FROM alpine:3.21

RUN apk add --no-cache ca-certificates tzdata

WORKDIR /app

COPY --from=builder /leanschool .
COPY testdata/receipts_template.xlsx ./receipts_template.xlsx

ENV RECEIPT_TEMPLATE_PATH=/app/receipts_template.xlsx

EXPOSE 8080

CMD ["./leanschool"]
