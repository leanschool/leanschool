# syntax=docker/dockerfile:1
# Build stage — context must be the repository root
FROM node:22-alpine AS builder

WORKDIR /app

COPY leanschool-ui/package*.json ./
RUN npm ci

COPY leanschool-ui/ .
RUN npm run build

# Runtime stage — serve with nginx
FROM nginx:1.27-alpine

COPY --from=builder /app/dist /usr/share/nginx/html
COPY infra/dockerfiles/config.js.template /etc/nginx/config.js.template
COPY infra/dockerfiles/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

EXPOSE 80

ENTRYPOINT ["/docker-entrypoint.sh"]
