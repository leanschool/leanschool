# syntax=docker/dockerfile:1
# Build stage — context must be the repo root
FROM golang:1.26-alpine AS builder

RUN apk add --no-cache ca-certificates tzdata

# Place the shared local module where the replace directive points
COPY leanschool-model/ /leanschool-model/

WORKDIR /app

COPY receipt-reader/ .

RUN go mod download && \
    CGO_ENABLED=0 GOOS=linux go build -o /receipt-reader ./cmd/...

# Runtime stage
FROM alpine:3.21

RUN apk add --no-cache \
    ca-certificates \
    tzdata \
    tesseract-ocr \
    tesseract-ocr-data-eng \
    tesseract-ocr-data-deu \
    tesseract-ocr-data-fra \
    tesseract-ocr-data-ita \
    imagemagick

WORKDIR /app

COPY --from=builder /receipt-reader .

EXPOSE 8080

CMD ["./receipt-reader"]
