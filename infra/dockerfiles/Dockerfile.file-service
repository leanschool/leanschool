# syntax=docker/dockerfile:1
# Build stage — context must be the repo root
FROM golang:1.26-alpine AS builder

RUN apk add --no-cache ca-certificates

WORKDIR /app

COPY file-service/ .

RUN go mod download && \
    CGO_ENABLED=0 GOOS=linux go build -o /file-service ./cmd/...

# Runtime stage
FROM alpine:3.21

RUN apk add --no-cache ca-certificates tzdata

RUN mkdir -p /data

WORKDIR /app

COPY --from=builder /file-service .

EXPOSE 8083

CMD ["./file-service"]
