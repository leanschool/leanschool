VITE_FILE_SERVICE_URL=http://localhost:8083
VITE_RECEIPT_READER_URL=http://localhost:8081
VITE_EXTRACTION_SERVICE_URL=http://localhost:8084
VITE_TIMETABLE_SERVICE_URL=http://localhost:8085

# Keycloak OIDC (PKCE)
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=leanschool
VITE_KEYCLOAK_CLIENT_ID=leanschool-ui

